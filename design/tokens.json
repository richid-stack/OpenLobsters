{
  "$comment": "Extracted from prototype/openlobs.html CSS variables. Flat colours only: no gradients.",
  "color": {
    "light": {
      "background": "#fff",
      "sidebar": "#f9f9f9",
      "text": "#0d0d0d",
      "textMuted": "#6b6b6b",
      "border": "#0000001a",
      "hover": "#0000000d",
      "bubble": "#f4f4f4",
      "popover": "#fff",
      "shadow": "0 4px 24px #0002"
    },
    "dark": {
      "background": "#212121",
      "sidebar": "#171717",
      "text": "#ececec",
      "textMuted": "#afafaf",
      "border": "#ffffff26",
      "hover": "#ffffff14",
      "bubble": "#303030",
      "popover": "#2f2f2f",
      "shadow": "0 4px 24px #0008"
    },
    "accent": "#e8442e"
  },
  "font": {
    "ui": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "display": "Newsreader, 'Iowan Old Style', Georgia, serif",
    "size": {
      "base": "16px",
      "row": "15.5px",
      "small": "13px",
      "h1": "clamp(32px,8vw,52px)",
      "h2": "clamp(26px,6vw,38px)"
    }
  },
  "radius": {
    "chip": "999px",
    "card": "28px",
    "control": "12px",
    "sheet": "22px 22px 0 0",
    "composer": "28px"
  },
  "motion": {
    "statusSwapOutMs": 120,
    "statusSwapInMs": 220,
    "statusSwapShiftPx": 6,
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "shimmerLoopMs": 1800,
    "panSpeedPxPerSec": 40,
    "panPauseMs": 600,
    "panHoldMs": 700,
    "panReturnMs": 260,
    "chipEnterMs": 180,
    "chipEnterScale": 0.85,
    "sheetMs": 340,
    "statusMinIntervalMs": 700,
    "tickerMaxChips": 24
  }
}