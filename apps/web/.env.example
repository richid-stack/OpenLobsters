# Everything here is optional. By default each person brings their own key in Models, and it stays in their browser.

# Self-hosting: keep provider keys on the server instead. Pattern: OPENLOBS_<PROVIDER_ID>_API_KEY
# OPENLOBS_OPENROUTER_API_KEY=
# OPENLOBS_OPENAI_API_KEY=
# OPENLOBS_ANTHROPIC_API_KEY=
# OPENLOBS_GOOGLE_API_KEY=
# OPENLOBS_GROQ_API_KEY=

# Allow model addresses on private networks, such as Ollama on the same machine (1 = allow, 0 = block).
# Default: allowed in development, blocked in production. Cloud-metadata and link-local addresses are always blocked.
# OPENLOBS_ALLOW_LOCAL_MODELS=1
