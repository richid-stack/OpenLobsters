# Everything here is optional. By default each person brings their own key in Models, and it stays in their browser.

# Self-hosting: keep provider keys on the server instead. Pattern: OPENLOBS_<PROVIDER_ID>_API_KEY
# OPENLOBS_OPENROUTER_API_KEY=
# OPENLOBS_OPENAI_API_KEY=
# OPENLOBS_ANTHROPIC_API_KEY=
# OPENLOBS_GOOGLE_API_KEY=
# OPENLOBS_GROQ_API_KEY=

# Allow model addresses on private networks, such as Ollama on the same machine (1 = allow, 0 = block).
# Default: allowed in development, blocked in production. Cloud-metadata and link-local addresses are always blocked.
# OPENLOBS_ALLOW_LOCAL_MODELS=1

# ---- Accounts and sign-in ----
# Required in production (32+ random characters) and the public https address of the app.
# BETTER_AUTH_SECRET=
# OPENLOBS_BASE_URL=https://your-domain.example
# Extra addresses allowed to call the sign-in API, comma separated.
# OPENLOBS_TRUSTED_ORIGINS=
# Where accounts and chats are stored (SQLite file). Default: data/openlobs.db
# OPENLOBS_DB_PATH=data/openlobs.db
# Close registration (existing accounts keep working).
# OPENLOBS_SIGNUPS=closed
# Turn off email and password sign-in (use only the providers below).
# OPENLOBS_AUTH_EMAIL=0
# Only believe X-Forwarded-For when a trusted proxy sets it (affects rate limiting of signed-out visitors).
# OPENLOBS_TRUST_PROXY=1

# A sign-in button appears only for a method whose id and secret are both set.
# OPENLOBS_AUTH_GITHUB_ID=
# OPENLOBS_AUTH_GITHUB_SECRET=
# OPENLOBS_AUTH_GOOGLE_ID=
# OPENLOBS_AUTH_GOOGLE_SECRET=
# OPENLOBS_AUTH_MICROSOFT_ID=
# OPENLOBS_AUTH_MICROSOFT_SECRET=
# OPENLOBS_AUTH_MICROSOFT_TENANT=common

# Any OpenID Connect provider (Keycloak, Okta, Auth0, Entra ID, a company login).
# The callback address to register with the provider is <OPENLOBS_BASE_URL>/api/auth/callback/<OPENLOBS_OIDC_ID>
# OPENLOBS_OIDC_ID=company
# OPENLOBS_OIDC_NAME=Company login
# OPENLOBS_OIDC_ISSUER=https://sso.example.com
# OPENLOBS_OIDC_CLIENT_ID=
# OPENLOBS_OIDC_CLIENT_SECRET=

# Email (confirmation and password reset). With this unset, nothing is emailed, confirmation is not required
# and "forgot password" is hidden.
# OPENLOBS_SMTP_URL=smtps://user:password@smtp.example.com:465
# OPENLOBS_MAIL_FROM="OpenLobs <no-reply@example.com>"
# OPENLOBS_AUTH_REQUIRE_VERIFIED_EMAIL=1
